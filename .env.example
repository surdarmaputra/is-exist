# Comma-separated list of browser origins allowed to call the checker API.
# Same-origin requests are always allowed and need no entry here.
# Development falls back to http://localhost:3200 when this is unset.
ALLOWED_ORIGINS=http://localhost:3200,https://is-exist.example.com

# Public URL used in canonical/Open Graph tags. Netlify supplies this from
# DEPLOY_PRIME_URL automatically; set it for a custom domain or local preview.
# SITE_URL=https://is-exist.netlify.app

# Set to 1 to build with the Netlify adapter. netlify.toml enables this for
# Netlify builds; leave it unset for the homelab/Node build.
# NETLIFY_DEPLOYMENT=1
